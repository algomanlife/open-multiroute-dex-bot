# ── Open Multiroute DEX Bot — environment template ───────────────────────────
# Copy to .env and fill in values. NEVER commit real secrets.

# General
NODE_ENV=development
LOG_LEVEL=info

# API server
API_PORT=3000
API_HOST=0.0.0.0
WEBHOOK_PASSPHRASE=change-me-a-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://omdb:omdb@localhost:5432/omdb?schema=public

# CORS (comma-separated origins; "*" allows all — avoid in production)
CORS_ORIGINS=http://localhost:3001

# Encryption key for exchange API credentials (32-byte hex)
# Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# SIWE auth
AUTH_SESSION_TTL_HOURS=168

# ── DEX credentials (only fill the ones you use) ─────────────────────────────
# dYdX v4
DYDX_V4_PRIVATE_KEY=
DYDX_V4_MNEMONIC=

# Hyperliquid
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_SLIPPAGE=0.005
HYPERLIQUID_BUILDER_FEE=0.0001

# GMX v2
GMX_PRIVATE_KEY=
GMX_RPC_URL=https://arb1.arbitrum.io/rpc

# Perpetual Protocol
PERP_PRIVATE_KEY=
PERP_RPC_URL=https://xlayer-rpc.arbitrum.io
PERP_SLIPPAGE=0.005

# Bluefin
BLUEFIN_API_KEY=
BLUEFIN_API_SECRET=
BLUEFIN_NETWORK=mainnet

# Gains Network (gains.trade) — demo/testnet by default (demo.gains.trade)
# Generate a dedicated agent key; fund it with testnet ETH + USDC for demo.
GAINS_AGENT_KEY=
GAINS_MASTER_KEY=
GAINS_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
GAINS_CHAIN=arbitrum-sepolia
GAINS_LEVERAGE=5
GAINS_COLLATERAL=USDC
GAINS_SLIPPAGE=1
